{
  "schema": 1,
  "rules": [
    {
      "id": "build",
      "when": "Standard implementation and Build units",
      "use": [{ "harness": "codex", "effort": "medium" }],
      "why": "Owner routing (2026-11-24): Codex gpt-6.1-sol at medium effort"
    },
    {
      "id": "bug-fix",
      "when": "Bug investigation and fix units",
      "use": [
        { "harness": "codex", "effort": "high" },
        { "harness": "claude-code", "capability": "deep", "effort": "high" }
      ],
      "why": "Codex Sol high first; escalate to high/xhigh or Claude Opus high only after 2 failures"
    },
    {
      "id": "frontend",
      "when": "Front-end interface units",
      "use": [{ "harness": "claude-code", "capability": "deep", "effort": "medium" }],
      "why": "Claude Code Opus 5.5 medium; capability deep is required because standard maps to Sonnet"
    },
    {
      "id": "plans-and-contracts",
      "when": "Planning and non-docs Task Contracts",
      "use": [{ "harness": "claude-code", "capability": "deep", "effort": "high" }],
      "why": "Claude Code Opus 5.5 high; second opinion uses agy once its adapter exists"
    },
    {
      "id": "independent-critique",
      "when": "Critique of a Build made by another vendor's model",
      "use": [
        { "harness": "claude-code", "capability": "deep", "effort": "high" },
        { "harness": "codex", "capability": "deep", "effort": "high" }
      ],
      "approval": "human",
      "why": "Critique never comes from the author's vendor"
    }
  ],
  "default": [{ "harness": "codex", "effort": "medium" }]
}
